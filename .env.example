# ──────────────────────────────────────────────────────────────────────────────
# ReviewNexus — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=production
FLASK_DEBUG=False

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Frontend origin for CORS (update to your Vercel/Netlify URL in production)
FRONTEND_URL=http://localhost:3000

# ─── Scraper ──────────────────────────────────────────────────────────────────
MAX_PLACES=15
MAX_REVIEWS_PER_PLACE=20
SCRAPER_TIMEOUT=60
HEADLESS_BROWSER=True

# ─── AI / Sentiment ───────────────────────────────────────────────────────────
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
SENTIMENT_SAMPLE_SIZE=10

# ─── Geocoding ────────────────────────────────────────────────────────────────
# Nominatim is free and requires no API key.
# Set a unique user agent string to comply with usage policy.
NOMINATIM_USER_AGENT=ReviewNexus/1.0 (educational project)

# ─── Caching ──────────────────────────────────────────────────────────────────
ENABLE_CACHE=True
CACHE_EXPIRY_HOURS=24

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
