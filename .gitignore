# ──────────────────────────────────────────────────────────────────────────────
# ReviewNexus — .gitignore
# ──────────────────────────────────────────────────────────────────────────────

# ─── Secrets (NEVER commit these) ────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─── Virtual environments ─────────────────────────────────────────────────────
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# ─── Playwright browser binaries ─────────────────────────────────────────────
# These are large (~150MB) and installed via playwright install in CI/CD
# ms-playwright/
# ~/.cache/ms-playwright/

# ─── Generated / cached data ──────────────────────────────────────────────────
data/
logs/
*.log

# ─── Node / Next.js ───────────────────────────────────────────────────────────
node_modules/
.next/
out/
frontend/.next/
frontend/out/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── IDE ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.AppleDouble
.LSOverride

# ─── Testing ─────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
*.ipynb

# ─── Flask ───────────────────────────────────────────────────────────────────
instance/
.webassets-cache

# ─── Docker ──────────────────────────────────────────────────────────────────
.dockerignore

# ─── CI/CD ───────────────────────────────────────────────────────────────────
.github/secrets/

# ─── Agent tools (local dev only) ────────────────────────────────────────────
.agents/